# Copy to .env, chmod 600, and replace every CHANGE_ME value.
# Pin image tags to reviewed immutable digests before production deployment.
NEXTCLOUD_IMAGE=nextcloud:31-apache
MARIADB_IMAGE=mariadb:11.4
REDIS_IMAGE=redis:7.2-alpine
NEXTCLOUD_PORT=8080
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
REDIS_PASSWORD=CHANGE_ME_redis_password
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_admin_password
