[Unit]
Description=GFYMS OpenHaystack-compatible Find My beacon
After=bluetooth.service
Wants=bluetooth.service
ConditionPathExists=/var/lib/gfyms/findmy/advertisement.key

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/share/gfyms/findmy/HCI.py --key-file /var/lib/gfyms/findmy/advertisement.key
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
