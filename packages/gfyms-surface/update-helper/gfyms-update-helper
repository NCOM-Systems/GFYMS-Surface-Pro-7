#!/usr/bin/env bash
set -eo pipefail
if [ "$#" -lt 1 ]; then echo "Usage: gfyms-update-helper {install|rollback} [package]" >&2; exit 2; fi
if [ "$(id -u)" -ne 0 ]; then echo "Use pkexec." >&2; exit 1; fi

rollback_dir=/var/lib/gfyms/rollback
mkdir -p "$rollback_dir"

save_current() {
    current="$(pacman -Q gfyms-surface 2>/dev/null | awk '{print $2}' || true)"
    [ -n "$current" ] || return 0
    cached="$(find /var/cache/pacman/pkg -maxdepth 1 -type f -name "gfyms-surface-$current-*.pkg.tar.zst" -print -quit 2>/dev/null || true)"
    [ -n "$cached" ] || return 0
    install -m 0644 "$cached" "$rollback_dir/$(basename "$cached")"
}

case "$1" in
    install)
        [ "$#" -eq 2 ] || { echo "Package path required." >&2; exit 2; }
        package="$2"
        [ -f "$package" ] || { echo "Package not found." >&2; exit 1; }
        case "$(basename "$package")" in gfyms-surface-*.pkg.tar.zst) ;; *) echo "Unexpected package name." >&2; exit 1 ;; esac
        save_current
        pacman -U --noconfirm --needed "$package"
        ;;
    rollback)
        previous="$(find "$rollback_dir" -maxdepth 1 -type f -name 'gfyms-surface-*.pkg.tar.zst' -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)"
        [ -n "$previous" ] || { echo "No rollback package available." >&2; exit 1; }
        pacman -U --noconfirm "$previous"
        ;;
    *) echo "Unknown action." >&2; exit 2 ;;
esac
