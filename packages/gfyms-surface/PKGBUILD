pkgname=gfyms-surface
pkgver=0.1.0
pkgrel=2
pkgdesc='Native Surface Pro 7 integration, controls and diagnostics for GFYMS'
arch=('x86_64')
url='https://github.com/pfn000/GFYMS-Surface-Pro-7'
license=('custom:GFYMS')
depends=('bash' 'coreutils' 'pciutils' 'usbutils' 'kcmutils' 'kirigami' 'qt6-declarative' 'qt6-base' 'python' 'bluez' 'bluez-utils')
makedepends=('cmake' 'extra-cmake-modules' 'qt6-tools')
optdepends=('dmidecode: additional hardware diagnostics' 'v4l-utils: camera diagnostics' 'iio-sensor-proxy: desktop sensor/rotation integration' 'fwupd: firmware inventory/update integration' 'gfyms-findmy: OpenHaystack-compatible Find My beacon integration')
source=()
sha256sums=()

build() {
  cp "$startdir/gfyms" "$srcdir/gfyms"
  cp "$startdir/gfyms-surface.service" "$srcdir/gfyms-surface.service"
  cp "$startdir/CMakeLists.txt" "$srcdir/CMakeLists.txt"
  cp "$startdir/LICENSE-GFYMS.txt" "$srcdir/LICENSE-GFYMS.txt"
  cp -a "$startdir/kcm-src" "$srcdir/src"
  cp -a "$startdir/center" "$srcdir/center"
  cp -a "$startdir/update-helper" "$srcdir/update-helper"
  cmake -B build -S . -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  install -Dm755 "$srcdir/gfyms" "$pkgdir/usr/bin/gfyms"
  install -Dm644 "$srcdir/gfyms-surface.service" "$pkgdir/usr/lib/systemd/system/gfyms-surface.service"
  install -Dm644 "$srcdir/LICENSE-GFYMS.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-GFYMS.txt"
  cmake --install build --prefix "$pkgdir/usr"
  install -Dm755 "$srcdir/update-helper/gfyms-update-helper" "$pkgdir/usr/libexec/gfyms-update-helper"
}
