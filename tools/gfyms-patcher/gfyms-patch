#!/usr/bin/env bash
set -euo pipefail

APP_NAME='GFYMS Arch Surface Patcher'
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
BACKUP_ROOT=${HOME}/.cache/gfyms-patch
BACKUP_DIR=${BACKUP_ROOT}/${STAMP}

die() { echo "ERROR: $*" >&2; exit 1; }
need_root() { [[ $(id -u) -eq 0 ]] || die 'Run with sudo: sudo ./gfyms-patch apply'; }
surface_check() {
  local product
  product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
  [[ "$product" == *'Surface Pro 7'* ]] || die "This machine is not identified as a Surface Pro 7 (reported: ${product:-unknown})."
}

snapshot() {
  mkdir -p "$BACKUP_DIR"
  uname -a > "$BACKUP_DIR/uname.txt"
  pacman -Q > "$BACKUP_DIR/packages-all.txt"
  pacman -Qqe > "$BACKUP_DIR/packages-explicit.txt"
  cp -a /etc/pacman.conf "$BACKUP_DIR/pacman.conf" 2>/dev/null || true
  cp -a /etc/mkinitcpio.conf "$BACKUP_DIR/mkinitcpio.conf" 2>/dev/null || true
  cp -a /etc/mkinitcpio.conf.d "$BACKUP_DIR/mkinitcpio.conf.d" 2>/dev/null || true
  cp -a /etc/default/grub "$BACKUP_DIR/grub" 2>/dev/null || true
  cp -a /etc/systemd/boot "$BACKUP_DIR/systemd-boot" 2>/dev/null || true
  echo "Snapshot: $BACKUP_DIR"
}

configure_linux_surface() {
  command -v curl >/dev/null 2>&1 || pacman -S --noconfirm --needed curl
  pacman-key --init
  curl -fsSL https://raw.githubusercontent.com/linux-surface/linux-surface/master/pkg/keys/surface.asc | pacman-key --add -
  pacman-key --finger 56C464BAAC421453
  pacman-key --lsign-key 56C464BAAC421453
  if ! grep -q '^\[linux-surface\]$' /etc/pacman.conf; then
    printf '%s\n' '' '[linux-surface]' 'Server = https://pkg.surfacelinux.com/arch/' >> /etc/pacman.conf
  fi
}

download_release_packages() {
  local out_dir=$1
  python3 - "$out_dir" <<'PY'
import hashlib
import json
import pathlib
import sys
import urllib.request

out = pathlib.Path(sys.argv[1])
out.mkdir(parents=True, exist_ok=True)
headers = {'Accept': 'application/vnd.github+json', 'User-Agent': 'GFYMS-Patcher'}
req = urllib.request.Request('https://api.github.com/repos/pfn000/GFYMS-Surface-Pro-7/releases/latest', headers=headers)
with urllib.request.urlopen(req, timeout=30) as response:
    release = json.load(response)

assets = {a['name']: a['browser_download_url'] for a in release.get('assets', []) if a.get('browser_download_url')}
manifest_url = assets.get('GFYMS-MANIFEST.json')
if not manifest_url:
    raise SystemExit('Latest GFYMS release has no GFYMS-MANIFEST.json.')

manifest_path = out / 'GFYMS-MANIFEST.json'
req = urllib.request.Request(manifest_url, headers=headers)
with urllib.request.urlopen(req, timeout=30) as response:
    manifest_path.write_bytes(response.read())
manifest = json.loads(manifest_path.read_text(encoding='utf-8'))

packages = manifest.get('packages', [])
if not packages:
    raise SystemExit('GFYMS manifest contains no packages.')

for item in packages:
    name = item['name']
    url = assets.get(name)
    if not url:
        raise SystemExit(f'Missing release asset: {name}')
    path = out / name
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=120) as response:
        path.write_bytes(response.read())
    expected = item.get('sha256', '').lower()
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if expected and actual != expected:
        raise SystemExit(f'SHA-256 verification failed for {name}.')
    print(path)
PY
}

check() {
  surface_check
  command -v pacman >/dev/null || die 'pacman is required.'
  echo "$APP_NAME"
  echo 'Surface Pro 7 detected.'
  echo 'Plan: linux-surface + iptsd + all GFYMS packages from the latest release.'
  echo 'No Microsoft Windows .sys/.dll/.exe drivers will be installed.'
  echo 'No firmware will be flashed automatically.'
}

apply_patch() {
  need_root
  surface_check
  snapshot
  configure_linux_surface
  pacman -Sy --noconfirm
  pacman -Syu --noconfirm --needed linux-surface linux-surface-headers iptsd
  local tmp_dir
  tmp_dir=$(mktemp -d)
  trap 'rm -rf "$tmp_dir"' EXIT
  download_release_packages "$tmp_dir"
  mapfile -t packages < <(find "$tmp_dir" -maxdepth 1 -type f -name 'gfyms-*.pkg.tar.zst' -print | sort)
  [[ ${#packages[@]} -gt 0 ]] || die 'No GFYMS package assets were downloaded.'
  pacman -U --noconfirm --needed "${packages[@]}"
  systemctl enable iptsd.service >/dev/null 2>&1 || true
  systemctl enable gfyms-surface.service >/dev/null 2>&1 || true
  systemctl enable gfyms-auto-update.timer >/dev/null 2>&1 || true
  echo
  echo 'GFYMS package set installed. Running verification:'
  /usr/bin/gfyms doctor || true
  echo
  echo "Rollback snapshot: $BACKUP_DIR"
}

verify() {
  surface_check
  [[ -x /usr/bin/gfyms ]] || die 'GFYMS package is not installed.'
  /usr/bin/gfyms doctor || true
}

report() {
  if [[ -x /usr/bin/gfyms ]]; then /usr/bin/gfyms doctor; else echo 'GFYMS is not installed.'; fi
}

case "${1:-check}" in
  check) check ;;
  plan) check ;;
  apply) apply_patch ;;
  verify) verify ;;
  report) report ;;
  rollback)
    need_root
    die 'Rollback is handled by the installed GFYMS update helper after the first successful package deployment; this patcher snapshot is retained for manual recovery.'
    ;;
  -h|--help|help)
    echo 'Usage: gfyms-patch {check|plan|apply|verify|report|rollback}'
    ;;
  *) die "Unknown command: $1" ;;
esac
