{
  "name": "gfyms-surface-pro-7",
  "display_name": "GFYMS Surface Pro 7",
  "description": "Arch-based Surface Pro 7 image profile focused on native Linux hardware enablement, Surface-specific diagnostics, and reproducible validation.",
  "base_image": "arch-linux",
  "use_case": "Surface Pro 7 hardware workstation",
  "hardware": {
    "platform": "pc",
    "architecture": "x86_64",
    "gpu": "intel",
    "min_cpu_cores": 2,
    "min_memory_gb": 4,
    "min_storage_gb": 32,
    "nic_count": 1
  },
  "os": {
    "features": [
      "desktop",
      "network",
      "surface-hardware",
      "camera",
      "biometrics",
      "power-management",
      "firmware-management",
      "hardware-diagnostics"
    ],
    "packages": [
      "base",
      "linux-firmware",
      "pipewire",
      "pipewire-alsa",
      "pipewire-pulse",
      "wireplumber",
      "bluez",
      "bluez-utils",
      "libcamera",
      "v4l-utils",
      "iio-sensor-proxy",
      "fwupd",
      "tpm2-tools",
      "tpm2-tss",
      "fprintd",
      "sof-firmware",
      "mesa",
      "libinput"
    ],
    "custom_packages": [
      "gfyms-surface-platform",
      "gfyms-surface-ipts",
      "gfyms-surface-pen",
      "gfyms-surface-typecover",
      "gfyms-surface-audio",
      "gfyms-surface-power",
      "gfyms-surface-sensors",
      "gfyms-surface-dock",
      "gfyms-ipu4",
      "gfyms-camera",
      "gfyms-camera-tuning",
      "gfyms-hello",
      "gfyms-tools"
    ],
    "excluded_packages": [
      "microsoft-windows-kernel-drivers",
      "microsoft-windows-hello-binaries"
    ],
    "branding": {
      "name": "GFYMS",
      "tagline": "Go Fix Your Microsoft Surface.",
      "device": "Surface Pro 7"
    }
  },
  "scenarios": [
    {
      "name": "boot-and-package-smoke",
      "tests": [
        "boot",
        "packages",
        "network"
      ],
      "assertions": [
        {
          "description": "GFYMS diagnostic command exists",
          "type": "command",
          "command": "gfyms doctor"
        },
        {
          "description": "Surface hardware profile is detected",
          "type": "command",
          "command": "gfyms hardware"
        }
      ]
    },
    {
      "name": "surface-userland-smoke",
      "tests": [
        "boot",
        "packages"
      ],
      "assertions": [
        {
          "description": "Bluetooth service is enabled",
          "type": "command",
          "command": "systemctl is-enabled bluetooth"
        },
        {
          "description": "Camera stack is present",
          "type": "command",
          "command": "libcamera-hello --list-cameras"
        }
      ]
    }
  ],
  "publish_to": [
    "local"
  ]
}