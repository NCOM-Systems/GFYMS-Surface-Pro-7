{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/gfyms/fastfetch-logo.txt",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": ": ",
    "key": {
      "width": 12
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "battery",
    "colors"
  ]
}
